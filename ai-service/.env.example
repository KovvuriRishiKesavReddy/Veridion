DATABASE_URL=postgres://postgres:postgres@localhost:5432/veridion
RABBITMQ_URL=amqp://localhost
GROQ_API_KEY=
PORT=4100
# Flow 6: where the ai-service tells the backend a decision is ready (so it can send notifications).
BACKEND_URL=http://localhost:4000
# Optional shared secret; must match INTERNAL_API_SECRET in backend/.env if you set one there.
# INTERNAL_API_SECRET=

# --- Production only (Render). Leave unset locally ---
# File storage via Supabase Storage (S3 protocol) — same 5 values in backend and ai-service:
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=ap-northeast-2
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=veridion-uploads
# (Cloudflare R2 also still works: R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME)
# NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
