DATABASE_URL=postgres://localhost:5432/veridion
JWT_SECRET=change_this_to_a_random_string
PORT=4000
# Flow 4: where the backend reaches the ai-service for synchronous calls (quotation
# ranking, the on-dispute-resolved vendor-risk update). Defaults to this value even if
# unset, so this line is optional — only needed if ai-service runs somewhere else.
AI_SERVICE_URL=http://localhost:4100

# Country code assumed for vendor phone numbers typed without one (default +91).
DEFAULT_COUNTRY_CODE=+91
# Flow 6: optional shared secret for ai-service -> backend notification calls (same value in ai-service/.env).
# INTERNAL_API_SECRET=

# --- Production only (Render). Leave unset locally: files then go to backend/uploads/ ---
# Cloudflare R2 file storage (same 4 values in ai-service)
# File storage via Supabase Storage (S3 protocol) — same 5 values in backend and ai-service:
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=ap-northeast-2
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=veridion-uploads
# (Cloudflare R2 also still works: R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME)
# Hosted Postgres (Supabase) needs SSL; it is enabled automatically for any non-localhost DATABASE_URL.
