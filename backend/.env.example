DATABASE_URL=postgres://localhost:5432/veridion
JWT_SECRET=change_this_to_a_random_string
PORT=4000
# Flow 4: where the backend reaches the ai-service for synchronous calls (quotation
# ranking, the on-dispute-resolved vendor-risk update). Defaults to this value even if
# unset, so this line is optional — only needed if ai-service runs somewhere else.
AI_SERVICE_URL=http://localhost:4100

# Country code assumed for vendor phone numbers typed without one (default +91).
DEFAULT_COUNTRY_CODE=+91
# Flow 6: optional shared secret for ai-service -> backend notification calls (same value in ai-service/.env).
# INTERNAL_API_SECRET=
